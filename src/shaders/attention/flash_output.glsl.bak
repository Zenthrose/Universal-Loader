#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 256) in;

layout(binding = 0) readonly buffer AttnWeights { float attn[]; };
layout(binding = 1) readonly buffer V { float v[]; };
layout(binding = 2) writeonly buffer Output { float out[]; };

layout(push_constant) uniform Params {
    uint seq_len;
    uint num_heads;
} params;

void main() {
    uint h = gl_GlobalInvocationID.x;
    
    if (h >= params.num_heads) return;
    
    uint head_dim = params.seq_len / params.num_heads;
    uint head_offset = h * head_dim;
    
    float sum = 0.0;
    
    for (uint t = 0; t < params.seq_len; ++t) {
        float attn = attn[t * params.num_heads + h];
        uint v_offset = t * params.num_heads * head_dim + head_offset;
        
        for (uint d = 0; d < head_dim; ++d) {
            float v_val = v[v_offset + d];
            sum += attn * v_val;
        }
    }
    
    out[h * head_dim + gl_GlobalInvocationID.x] = sum;
}
